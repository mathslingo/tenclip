# TenClip pose_server_v2（RTMpose CPU）— 0.0.0.0:5000
# Nginx 将 https://api.uchance.tech/detect|/health 反代到本进程
#
#   sudo cp scripts/deploy/tenclip-pose.service /etc/systemd/system/tenclip-pose.service
#   sudo systemctl daemon-reload
#   sudo systemctl restart tenclip-pose

[Unit]
Description=TenClip RTMpose v2 for api.uchance.tech
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/code/tenclip/pose
Environment=OMP_NUM_THREADS=4
Environment=POSE_MAX_SIDE=320
Environment=PATH=/root/miniconda3/envs/pose/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/miniconda3/envs/pose/bin/python pose_server_v2.py --size s --port 5000
Restart=always
RestartSec=5
MemoryMax=3G

[Install]
WantedBy=multi-user.target
