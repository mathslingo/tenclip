# TenClip @ 阿里云 ECS（uchance.tech）— 127.0.0.1:7861
#
# 安装前请改 User / WorkingDirectory / PATH / ExecStart 与机器一致：
#
#   sudo cp scripts/deploy/tenclip-uchance-tech.service /etc/systemd/system/tenclip-api.service
#   sudo nano /etc/systemd/system/tenclip-api.service
#   # 密钥：sudo cp scripts/deploy/tenclip.env.example /etc/tenclip/env && sudo nano /etc/tenclip/env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tenclip-api
#   curl -s http://127.0.0.1:7861/api/mobile/health

[Unit]
Description=TenClip app.py for api.uchance.tech (port 7861)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/code/tenclip
Environment=GRADIO_SERVER_NAME=127.0.0.1
Environment=GRADIO_SERVER_PORT=7861
# 2GiB 机器若无本地 VLM，可注释下一行，避免误加载大模型
# Environment=TENCLIP_VLM_MODEL=/root/code/tenclip/model/Qwen2-VL-2B-Instruct
Environment=PATH=/root/miniconda3/envs/tenclip/bin:/usr/local/bin:/usr/bin:/bin
# 微信 / 管理密钥：/etc/tenclip/env（见 tenclip.env.example）；勿把 Secret 写进本 unit
EnvironmentFile=-/etc/tenclip/env
ExecStart=/root/miniconda3/envs/tenclip/bin/python app.py
Restart=always
RestartSec=5

# 防止偶发内存尖峰拖死整机（按需调整）
# MemoryMax=1800M

[Install]
WantedBy=multi-user.target
