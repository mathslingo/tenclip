# 生产密钥环境文件（勿提交真实值到 git）
# 安装：
#   sudo mkdir -p /etc/tenclip
#   sudo cp scripts/deploy/tenclip.env.example /etc/tenclip/env
#   sudo nano /etc/tenclip/env          # 填入真实 AppID / Secret
#   sudo chmod 600 /etc/tenclip/env
#   sudo chown root:root /etc/tenclip/env
#   sudo systemctl daemon-reload
#   sudo systemctl restart tenclip-api
#
# systemd 通过 EnvironmentFile=/etc/tenclip/env 加载（见 tenclip-api.service）

# 微信小程序登录（公众平台 → 开发 → 开发管理 → 开发设置）
TENCLIP_WECHAT_APPID=wx你的AppID
TENCLIP_WECHAT_SECRET=你的AppSecret

# 管理接口（GET /api/admin/users 等）；不配则管理接口不可用
# TENCLIP_ADMIN_TOKEN=换成足够长的随机串

# 生产禁止开启：
# TENCLIP_WECHAT_MOCK=1
