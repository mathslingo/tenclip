# systemd 单元示例：云服务器上常驻 app.py（小程序 API）
# 安装：
#   sudo cp scripts/deploy/tenclip-api.service /etc/systemd/system/
#   sudo sed -i "s|/home/hayden/code/tenclip|$(pwd)|g" /etc/systemd/system/tenclip-api.service
#   sudo sed -i "s|User=hayden|User=$(whoami)|g" /etc/systemd/system/tenclip-api.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now tenclip-api

[Unit]
Description=TenClip app.py (Gradio + /api/mobile for miniprogram)
After=network.target

[Service]
Type=simple
User=hayden
WorkingDirectory=/home/hayden/code/tenclip
Environment=GRADIO_SERVER_NAME=127.0.0.1
Environment=GRADIO_SERVER_PORT=7861
Environment=TENCLIP_VLM_MODEL=/home/hayden/code/tenclip/model/Qwen2-VL-2B-Instruct
ExecStart=/home/hayden/miniconda3/envs/tenclip/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
