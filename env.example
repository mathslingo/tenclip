# 复制为 .env 后由 python-dotenv 读取（可选）；不复制则仅用系统环境变量。
# 本项目推荐在 WSL2 + conda 环境 tenclip 中使用；见 readme.md「开发约定」。

# Gradio
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# 模型路径：若仓库下已有 model/Qwen2-VL-2B-Instruct/，app.py 会自动设置 TENCLIP_VLM_MODEL，通常不必写。
# 仅当要用远程 ID 拉取或覆盖本地路径时再设置，例如：
# TENCLIP_VLM_MODEL=/home/you/code/tenclip/model/Qwen2-VL-2B-Instruct
# TENCLIP_VLM_MODEL=Qwen/Qwen2-VL-2B-Instruct

# 仅当需要首次从远端下载时才关注下面两项；本地 model/ 已就绪时可不改。
TENCLIP_MODEL_DOWNLOAD_SOURCE=modelscope
# ModelScope 慢时改用 Hugging Face + 镜像（与 huggingface_hub 文档一致）：
# TENCLIP_MODEL_DOWNLOAD_SOURCE=huggingface
# HF_ENDPOINT=https://hf-mirror.com
# 或仅写别名（代码里会同步到 HF_ENDPOINT）：
# TENCLIP_HF_ENDPOINT=https://hf-mirror.com

# 需要代理下载时（端口按本机代理改）：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 权重复制到项目：bash scripts/copy_vlm_to_model.sh（完成后一般无需再配 TENCLIP_VLM_MODEL）

# LLaMA-Factory 文本侧实验（与网球 VLM 主线独立，可选）
TENCLIP_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
TENCLIP_LLM_MODEL_DOWNLOAD_SOURCE=modelscope
# TENCLIP_LLM_CACHE_DIR=/home/you/llm-cache

# 推理：auto | llamafactory | transformers
TENCLIP_INFER_BACKEND=auto

# 弱显卡 / 无显卡
# TENCLIP_FORCE_CPU=1

# 分析时长上限（秒）
TENCLIP_MAX_VIDEO_SEC=300

# 异步分析上传文件保留天数（超期删磁盘文件，DB 中 analysis_videos 标为 expired；默认 60）
# TENCLIP_VIDEO_RETENTION_DAYS=60

# VLM 单次生成 max_new_tokens（不设则随「省显存/平衡/质量」档位使用代码内默认）。
# 若长文（如 motion_deep）在句中被截断，可适当增大，例如 2048（显存占用会上升）。
# TENCLIP_MAX_NEW_TOKENS=2048

# 网球 VLM 分析：系统提示词档位（default / compact / step_by_step / step_by_step_v2 / motion_deep）。
# Gradio / Mobile 页 / API 传入的档位会覆盖此处；未传时才用本默认值。
# TENCLIP_PROMPT_PROFILE=motion_deep
# 追加到系统提示词末尾的短句（快速试验）
# TENCLIP_PROMPT_APPEND=

# 网坛新闻抓取：单次 HTTP 超时（秒）与「单来源」总预算（秒）；超预算会跳过该来源继续下一个。
# TENCLIP_NEWS_HTTP_TIMEOUT_SEC=12
# TENCLIP_NEWS_SOURCE_TIMEOUT_SEC=28
# 来源列表 JSON（不设则使用仓库内 config/news_sources.json）
# TENCLIP_NEWS_SOURCES_CONFIG=/home/you/code/tenclip/config/news_sources.json

# ModelScope 缓存目录（可选，WSL 示例）
# MODELSCOPE_CACHE=/home/you/modelscope-cache

# run-wsl.sh / download-vlm-conda.sh 使用（写在 shell 里即可，不必放 .env）
# export MINICONDA_ROOT=/home/you/miniconda3
