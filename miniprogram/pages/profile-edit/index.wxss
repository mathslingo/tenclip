.edit-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  box-sizing: border-box;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0d3d32;
}

.nick-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e7582;
}

.picker-value {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f7f9;
  font-size: 28rpx;
  color: #151821;
}

.avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0faf6;
  border: none;
  line-height: 120rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
}

.avatar-placeholder {
  font-size: 24rpx;
  color: #0d6b52;
}

.form-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #151821;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f7f9;
  font-size: 28rpx;
  color: #151821;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #f5f7f9;
  font-size: 28rpx;
  color: #151821;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.ghost {
  background: #eef2f5;
  color: #415360;
}

.btn.solid {
  background: linear-gradient(140deg, #3bf0bf, #13d8a8);
  color: #fff;
}
