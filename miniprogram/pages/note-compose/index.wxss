.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f8fa;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.title-input {
  font-size: 34rpx;
  font-weight: 600;
  color: #151821;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
  margin-bottom: 20rpx;
}

.body-input {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.count {
  display: block;
  text-align: right;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa3ad;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #151821;
}

.section-hint {
  font-size: 22rpx;
  color: #9aa3ad;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell,
.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.img {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  border: 2rpx dashed #d0d5dd;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.add-plus {
  font-size: 48rpx;
  color: #13d8a8;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #8a8a8a;
}

.publish-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #13d8a8, #0fb894);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.publish-btn[disabled] {
  opacity: 0.6;
}

.tip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa3ad;
}

.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.opt-left {
  flex: 1;
  min-width: 0;
}

.opt-left .section-title {
  display: block;
}

.opt-left .section-hint {
  display: block;
  margin-top: 6rpx;
}

.loc-box,
.time-box {
  margin-top: 20rpx;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  background: #f7faf9;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.loc-pin {
  width: 28rpx;
  height: 36rpx;
  flex-shrink: 0;
  position: relative;
}
.loc-pin::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50% 50% 50% 0;
  background: #13d8a8;
  transform: rotate(-45deg);
}
.loc-pin::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: #fff;
  z-index: 1;
}

.loc-meta {
  flex: 1;
  min-width: 0;
}

.loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #151821;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-name.muted {
  font-weight: 500;
  color: #5c6570;
}

.loc-addr {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa3ad;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-arrow {
  color: #c0c5ce;
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.loc-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
  padding-left: 4rpx;
}

.loc-action {
  font-size: 24rpx;
  color: #13d8a8;
}

.loc-action.danger {
  color: #9aa3ad;
}

.time-label {
  font-size: 26rpx;
  color: #6e7582;
  flex-shrink: 0;
}

.time-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #0d3d32;
}
