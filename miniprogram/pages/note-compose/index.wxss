.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f8fa;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.title-input {
  font-size: 34rpx;
  font-weight: 600;
  color: #151821;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
  margin-bottom: 20rpx;
}

.body-input {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.count {
  display: block;
  text-align: right;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa3ad;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #151821;
}

.section-hint {
  font-size: 22rpx;
  color: #9aa3ad;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell,
.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.img {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  border: 2rpx dashed #d0d5dd;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.add-plus {
  font-size: 48rpx;
  color: #13d8a8;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #8a8a8a;
}

.publish-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #13d8a8, #0fb894);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.publish-btn[disabled] {
  opacity: 0.6;
}

.tip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa3ad;
}
