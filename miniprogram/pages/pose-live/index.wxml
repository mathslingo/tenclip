<view class="live-page">
  <camera
    wx:if="{{!showResult}}"
    class="cam"
    device-position="{{devicePosition}}"
    flash="off"
    resolution="medium"
    frame-size="medium"
    binderror="onCamError"
    bindinitdone="onCamReady"
  />

  <video
    wx:if="{{showResult && resultVideo}}"
    class="result-video"
    src="{{resultVideo}}"
    controls
    autoplay
    loop
    object-fit="cover"
  />

  <cover-view class="hud" wx:if="{{!showResult}}">
    <cover-view class="hud-top">
      <cover-view class="pill">{{statusText}}</cover-view>
      <cover-view class="pill rec" wx:if="{{recording}}">● {{timerText}}</cover-view>
      <cover-view class="pill" wx:if="{{progressText}}">{{progressText}}</cover-view>
    </cover-view>
    <cover-view class="hud-bottom">
      <cover-view class="btn" bindtap="onToggleDevice" wx:if="{{!recording && !busy}}">翻转</cover-view>
      <cover-view class="btn primary" bindtap="onToggleRecord">
        {{recording ? '停止并分析' : '开始录制'}}
      </cover-view>
      <cover-view class="btn" bindtap="onBack">返回</cover-view>
    </cover-view>
  </cover-view>

  <view class="result-bar" wx:if="{{showResult}}">
    <text class="result-msg">{{statusText}}</text>
    <view class="result-actions">
      <button class="result-btn" bindtap="onRetake">再录一条</button>
      <button class="result-btn ghost" bindtap="onBack">返回</button>
    </view>
  </view>
</view>
