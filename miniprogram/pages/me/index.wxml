<view class="me-page">
  <!-- 小红书式头图 + 身份区 -->
  <view class="profile-cover">
    <view class="cover-wash"></view>
    <view class="cover-actions">
      <view class="cover-btn" bindtap="onToggleSettings">设置</view>
      <view class="cover-btn primary" bindtap="onEditProfile">编辑资料</view>
    </view>
  </view>

  <view class="profile-panel">
    <view class="identity-row">
      <view class="avatar-wrap" bindtap="onEditProfile">
        <image wx:if="{{profile.avatarUrl}}" class="avatar-img" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback">{{avatarLetter}}</view>
      </view>
      <view class="identity-main">
        <view class="name-row">
          <text class="nickname">{{profile.nickname}}</text>
          <text class="gender-pill" wx:if="{{profile.gender}}">{{profile.gender}}</text>
        </view>
        <text class="uid-line">小程序号：{{profile.uid}} · IP：{{profile.location}}</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat" bindtap="onTapFollowing">
        <text class="stat-num">{{stats.following}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat" bindtap="onTapFollowers">
        <text class="stat-num">{{stats.followers}}</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.likedCollect}}</text>
        <text class="stat-label">获赞与收藏</text>
      </view>
    </view>

    <text class="bio">{{profile.bio}}</text>
    <view class="tag-row" wx:if="{{profile.tags.length}}">
      <text class="interest-tag" wx:for="{{profile.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 快捷入口（原工具菜单） -->
  <view class="quick-row">
    <view class="quick-card" bindtap="onGoStroke">
      <text class="quick-icon">✂</text>
      <text class="quick-label">击球剪辑</text>
    </view>
    <!-- 暂时下线：动作分析
    <view class="quick-card" bindtap="onGoAnalyze">
      <text class="quick-icon">◎</text>
      <text class="quick-label">动作分析</text>
    </view>
    -->
    <view class="quick-card" bindtap="onGoPose">
      <text class="quick-icon">◇</text>
      <text class="quick-label">实时关键点</text>
    </view>
    <view class="quick-card" bindtap="onGoFeed">
      <text class="quick-icon">▣</text>
      <text class="quick-label">发现资讯</text>
    </view>
  </view>

  <!-- 内容 Tab -->
  <view class="content-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="content-tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >
      <text>{{item.label}}</text>
      <text class="tab-count" wx:if="{{item.count != null}}">{{item.count}}</text>
    </view>
  </view>

  <view class="waterfall" wx:if="{{leftList.length || rightList.length}}">
    <view class="col">
      <view
        class="note-card"
        wx:for="{{leftList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <view class="cover-wrap" style="padding-bottom: {{item.cover_ratio * 100}}%;">
          <image
            wx:if="{{!item.coverFailed}}"
            class="cover"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
            data-id="{{item.id}}"
            data-col="left"
            binderror="onCoverError"
          />
          <view wx:else class="cover-fallback">
            <text class="fallback-letter">{{item.author_initial}}</text>
          </view>
        </view>
        <view class="note-body">
          <text class="note-title">{{item.title}}</text>
        </view>
      </view>
    </view>
    <view class="col">
      <view
        class="note-card"
        wx:for="{{rightList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <view class="cover-wrap" style="padding-bottom: {{item.cover_ratio * 100}}%;">
          <image
            wx:if="{{!item.coverFailed}}"
            class="cover"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
            data-id="{{item.id}}"
            data-col="right"
            binderror="onCoverError"
          />
          <view wx:else class="cover-fallback">
            <text class="fallback-letter">{{item.author_initial}}</text>
          </view>
        </view>
        <view class="note-body">
          <text class="note-title">{{item.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-block" wx:else>
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-sub">{{emptySub}}</text>
    <view class="empty-cta" bindtap="onEmptyCta" wx:if="{{emptyCta}}">{{emptyCta}}</view>
  </view>

  <!-- 开发设置（默认收起） -->
  <view class="settings-card" wx:if="{{showSettings}}">
    <text class="settings-title">开发者选项</text>
    
    <!-- 开发者模式开关 -->
    <view class="switch-row dev-mode-switch">
      <view class="switch-text">
        <text class="switch-label">🔧 开发者模式</text>
        <text class="switch-hint">开启后，分析页面显示调试功能和详细日志</text>
      </view>
      <switch checked="{{devMode}}" bindchange="onDevModeChange" color="#667eea" />
    </view>

    <block wx:if="{{localDev}}">
      <text class="settings-title" style="margin-top: 32rpx;">数据源与调试</text>
      <view class="switch-row">
        <view class="switch-text">
          <text class="switch-label">资讯使用 Mock</text>
          <text class="switch-hint">关闭后请求本机 /api/news/feed；失败回退 Mock。</text>
        </view>
        <switch checked="{{feedUseMock}}" bindchange="onMockChange" color="#13d8a8" />
      </view>
      <text class="build-tag">Build {{buildTag}}</text>
      <text class="build-tag">API {{apiBase}} · 本机库</text>
    </block>
  </view>
</view>

<!-- 编辑资料弹层 -->
<view class="edit-mask" wx:if="{{editing}}" catchtouchmove="noop">
  <view class="edit-sheet">
    <text class="edit-title">编辑资料</text>
    <text class="field-label">昵称</text>
    <input class="field-input" value="{{editForm.nickname}}" maxlength="20" bindinput="onEditNick" />
    <text class="field-label">简介</text>
    <textarea
      class="field-area"
      value="{{editForm.bio}}"
      maxlength="80"
      auto-height
      bindinput="onEditBio"
    />
    <text class="field-label">兴趣标签（逗号分隔）</text>
    <input class="field-input" value="{{editForm.tagsText}}" maxlength="40" bindinput="onEditTags" />
    <view class="edit-actions">
      <view class="edit-btn ghost" bindtap="onCancelEdit">取消</view>
      <view class="edit-btn solid" bindtap="onSaveEdit">保存</view>
    </view>
  </view>
</view>
