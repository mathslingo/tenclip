.msg-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.msg-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eee;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #baf5e8, #13d8a8);
  color: #fff;
  font-size: 30rpx;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: wrap;
}

.actor-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.action-text {
  font-size: 26rpx;
  color: #888;
}

.preview {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #aaa;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.empty,
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
