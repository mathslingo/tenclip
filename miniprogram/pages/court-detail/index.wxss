.detail-page {
  background: #f2f3f5;
  min-height: 100vh;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ── 图片轮播 ── */
.hero-section {
  position: relative;
  width: 100%;
  height: 480rpx;
}
.photo-swiper { width: 100%; height: 480rpx; }
.swiper-img { width: 100%; height: 100%; background: #e8ecf1; }
.photo-count {
  position: absolute;
  right: 20rpx; bottom: 20rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.hero-fallback {
  width: 100%; height: 360rpx;
  background: linear-gradient(135deg, #baf5e8 0%, #d4fff4 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.hero-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.hero-name { font-size: 36rpx; font-weight: 700; color: #0d3d32; }

/* ── 信息卡片 ── */
.info-section {
  background: #fff;
  margin: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.court-name {
  font-size: 38rpx; font-weight: 700; color: #1a1f26;
  flex: 1; margin-right: 20rpx;
}
.rating-badge {
  background: linear-gradient(135deg, #f5a623 0%, #f7b84e 100%);
  padding: 8rpx 20rpx; border-radius: 16rpx; flex-shrink: 0;
}
.rating-text { font-size: 32rpx; font-weight: 700; color: #fff; }
.rating-unit { font-size: 20rpx; color: rgba(255,255,255,0.85); margin-left: 4rpx; }

.sub-row { margin-top: 14rpx; font-size: 26rpx; color: #6e7582; }
.dist-text { color: #13d8a8; font-weight: 500; }

.divider { height: 2rpx; background: #f0f3f6; margin: 28rpx 0; }

/* ── 信息行 ── */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
.info-label { font-size: 28rpx; color: #6e7582; flex-shrink: 0; }
.info-value { font-size: 28rpx; color: #1a1f26; text-align: right; }
.info-value.price { color: #0d3d32; font-weight: 700; font-size: 30rpx; }
.info-value.address { max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-value-wrap { display: flex; align-items: center; gap: 16rpx; }
.nav-link { font-size: 24rpx; color: #13d8a8; flex-shrink: 0; }

/* ── 场地统计 ── */
.court-stats { display: flex; gap: 24rpx; margin-bottom: 28rpx; }
.stat-item {
  flex: 1; background: #f7faf8; padding: 20rpx;
  border-radius: 16rpx; text-align: center;
}
.stat-num { display: block; font-size: 40rpx; font-weight: 700; color: #0d3d32; }
.stat-label { display: block; font-size: 22rpx; color: #6e7582; margin-top: 6rpx; }

/* ── 设施 ── */
.section-title { font-size: 28rpx; font-weight: 600; color: #1a1f26; margin-bottom: 18rpx; }
.facility-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.facility-chip {
  font-size: 24rpx; color: #0d3d32; background: #d4fff4;
  padding: 10rpx 22rpx; border-radius: 32rpx; border: 2rpx solid #baf5e8;
}

/* ── 外部评价源 ── */
.ext-section { margin-top: 8rpx; }
.ext-buttons { display: flex; flex-direction: column; gap: 12rpx; }
.ext-btn {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  background: #f7faf8;
  border-radius: 16rpx;
  border: 2rpx solid #e8ecf1;
}
.ext-icon { font-size: 36rpx; margin-right: 16rpx; }
.ext-name { flex: 1; font-size: 28rpx; color: #1a1f26; }
.ext-arrow { font-size: 32rpx; color: #9aa3af; }

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-top: 2rpx solid #e8ecf1; z-index: 99;
}
.bottom-inner {
  display: flex; align-items: center;
  padding: 16rpx 24rpx; gap: 16rpx;
}
.bottom-actions { display: flex; flex-shrink: 0; }
.action-btn {
  display: flex; flex-direction: column; align-items: center;
  padding: 12rpx 16rpx;
}
.action-btn.share-btn {
  background: none; border: none; margin: 0; line-height: 1; padding: 12rpx 16rpx;
}
.action-btn.share-btn::after { border: none; }
.action-icon { font-size: 36rpx; }
.action-label { font-size: 20rpx; color: #6e7582; margin-top: 4rpx; }

.main-book-btn {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #3bf0bf 0%, #13d8a8 100%);
  border-radius: 20rpx; padding: 18rpx 0;
}
.main-book-btn.disabled {
  background: #d0d5dd;
}
.book-text { font-size: 28rpx; font-weight: 700; color: #fff; }
.book-sub { font-size: 20rpx; color: rgba(255,255,255,0.8); margin-top: 2rpx; }

/* 更多渠道 */
.more-channels {
  display: flex; align-items: center; flex-wrap: wrap;
  padding: 12rpx 24rpx; gap: 8rpx; border-top: 1rpx solid #f0f3f6;
}
.channels-label { font-size: 22rpx; color: #9aa3af; }
.channel-link {
  font-size: 22rpx; color: #13d8a8;
  background: #d4fff4; padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.safe-area { padding-bottom: env(safe-area-inset-bottom); }

/* ── 状态 ── */
.status-wrap {
  display: flex; justify-content: center; align-items: center;
  min-height: 100vh;
}
.status-text { font-size: 28rpx; color: #9aa3af; }
.status-error { font-size: 28rpx; color: #b42318; }
