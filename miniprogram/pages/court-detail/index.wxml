<view class="detail-page" wx:if="{{!loading && court}}">

  <!-- 图片轮播 -->
  <view class="hero-section" wx:if="{{court.photos.length}}">
    <swiper
      class="photo-swiper"
      indicator-dots="{{court.photos.length > 1}}"
      indicator-color="#ffffff80"
      indicator-active-color="#13d8a8"
      autoplay="{{false}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{court.photos}}" wx:key="*this">
        <image
          class="swiper-img"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          data-index="{{index}}"
          bindtap="onPreviewImage"
          binderror="onPhotoError"
        />
      </swiper-item>
    </swiper>
    <view class="photo-count" wx:if="{{court.photos.length > 1}}">
      <text>{{coverIndex + 1}}/{{court.photos.length}}</text>
    </view>
  </view>

  <!-- 无照片封面 -->
  <view wx:else class="hero-fallback">
    <text class="hero-emoji">🎾</text>
    <text class="hero-name">{{court.name}}</text>
  </view>

  <!-- 主体信息 -->
  <view class="info-section">

    <!-- 名称 + 评分 -->
    <view class="title-row">
      <text class="court-name">{{court.name}}</text>
      <view class="rating-badge" wx:if="{{court.rating}}">
        <text class="rating-text">{{court.rating}}</text>
        <text class="rating-unit">分</text>
      </view>
    </view>

    <view class="sub-row">
      <text wx:if="{{court.distanceText}}" class="dist-text">📍 {{court.distanceText}}</text>
      <text class="type-text">· {{court.courtType}}{{court.totalCourts}}片场地</text>
    </view>

    <view class="divider"></view>

    <view class="info-row">
      <text class="info-label">参考价格</text>
      <text class="info-value price">¥{{court.priceRange}}/小时</text>
    </view>

    <view class="info-row">
      <text class="info-label">地址</text>
      <view class="info-value-wrap">
        <text class="info-value address">{{court.address}}</text>
        <text class="nav-link" bindtap="onNavigate">🧭 导航</text>
      </view>
    </view>

    <view class="info-row" wx:if="{{court.phone}}">
      <text class="info-label">电话</text>
      <view class="info-value-wrap">
        <text class="info-value">{{court.phone}}</text>
        <text class="nav-link" bindtap="onCall">📞 拨打</text>
      </view>
    </view>

    <view class="info-row" wx:if="{{court.hours}}">
      <text class="info-label">营业时间</text>
      <text class="info-value">{{court.hours}}</text>
    </view>

    <view class="divider"></view>

    <!-- 场地统计 -->
    <view class="court-stats">
      <view class="stat-item" wx:if="{{court.indoorCourts > 0}}">
        <text class="stat-num">{{court.indoorCourts}}</text>
        <text class="stat-label">室内场地</text>
      </view>
      <view class="stat-item" wx:if="{{court.outdoorCourts > 0}}">
        <text class="stat-num">{{court.outdoorCourts}}</text>
        <text class="stat-label">室外场地</text>
      </view>
    </view>

    <!-- 设施 -->
    <view class="facility-section" wx:if="{{court.facilities.length}}">
      <text class="section-title">设施与服务</text>
      <view class="facility-chips">
        <text class="facility-chip" wx:for="{{court.facilities}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 外部评价 -->
    <view class="ext-section" wx:if="{{court.extSources.length}}">
      <text class="section-title">💬 看看大家怎么说</text>
      <view class="ext-buttons">
        <view
          wx:for="{{court.extSources}}"
          wx:key="name"
          class="ext-btn"
          data-index="{{index}}"
          bindtap="onExtSource"
        >
          <text class="ext-icon">{{item.icon}}</text>
          <text class="ext-name">{{item.name}}上看评价</text>
          <text class="ext-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部预定栏 -->
  <view class="bottom-bar">
    <view class="bottom-inner">
      <view class="bottom-actions">
        <view class="action-btn" bindtap="onOpenLocation">
          <text class="action-icon">📍</text>
          <text class="action-label">地图</text>
        </view>
        <button class="action-btn share-btn" open-type="share">
          <text class="action-icon">↗️</text>
          <text class="action-label">分享</text>
        </button>
      </view>
      <!-- 主预定按钮：第一个渠道为核心入口 -->
      <view class="main-book-btn" bindtap="onMainBook" wx:if="{{court.bookingOptions && court.bookingOptions.length}}">
        <text class="book-text">预约打球 🎾</text>
        <text class="book-sub">{{court.bookingOptions[0].name}}</text>
      </view>
      <view class="main-book-btn disabled" wx:else>
        <text class="book-text">暂不支持在线预定</text>
      </view>
    </view>
    <!-- 更多预定渠道 -->
    <view class="more-channels" wx:if="{{court.bookingOptions.length > 1}}">
      <text class="channels-label">更多预定方式：</text>
      <view class="channels-row">
        <text
          wx:for="{{court.bookingOptions}}"
          wx:key="name"
          wx:if="{{index > 0}}"
          class="channel-link"
          data-index="{{index}}"
          bindtap="onChannelBook"
        >{{item.name}}</text>
      </view>
    </view>
    <view class="safe-area"></view>
  </view>
</view>

<!-- 加载/错误状态 -->
<view class="status-wrap" wx:if="{{loading}}">
  <text class="status-text">加载中…</text>
</view>
<view class="status-wrap" wx:if="{{!loading && errorText}}">
  <text class="status-error">{{errorText}}</text>
</view>
