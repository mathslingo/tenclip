.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.swiper {
  width: 100%;
  height: 720rpx;
  background: #111;
}

.slide {
  width: 100%;
  height: 100%;
}

.author-row {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d4fff4;
  color: #0d3d32;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-letter {
  line-height: 1;
}

.author-meta {
  flex: 1;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #151821;
}

.time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa3ad;
}

.follow-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #13d8a8;
  color: #fff;
  font-size: 24rpx;
}

.follow-btn.on {
  background: #eef1f4;
  color: #5c6570;
}

.body-card {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #151821;
  margin-bottom: 12rpx;
}

.meta {
  display: block;
  font-size: 22rpx;
  color: #9aa3ad;
  margin-bottom: 20rpx;
}

.body {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.65;
  white-space: pre-wrap;
}

.meta-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef0f3;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #9aa3ad;
  flex-shrink: 0;
}

.meta-value {
  font-size: 26rpx;
  color: #0d3d32;
  font-weight: 600;
}

.loc-row {
  margin-top: 20rpx;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  background: #f7faf9;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.loc-pin {
  width: 28rpx;
  height: 36rpx;
  flex-shrink: 0;
  position: relative;
}
.loc-pin::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50% 50% 50% 0;
  background: #13d8a8;
  transform: rotate(-45deg);
}
.loc-pin::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: #fff;
  z-index: 1;
}

.loc-meta {
  flex: 1;
  min-width: 0;
}

.loc-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #151821;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-addr {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa3ad;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-go {
  font-size: 24rpx;
  color: #13d8a8;
  flex-shrink: 0;
}

.danger-btn {
  margin: 8rpx 24rpx 0;
  background: #fff;
  color: #b42318;
  border-radius: 999rpx;
  border: 2rpx solid rgba(180, 35, 24, 0.25);
  font-size: 28rpx;
}

.action-bar {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 24rpx 0;
}

.action-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #415360;
  background: #f5f7f9;
  font-weight: 500;
}

.action-chip.on {
  color: #0d3d32;
  background: #e8faf4;
  font-weight: 600;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8a8a8a;
  font-size: 28rpx;
}

.comment-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0;
}

.comment-header {
  padding: 24rpx 28rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #151821;
}

.comment-count {
  display: block;
  margin-bottom: 20rpx;
}

.comment-list {
  padding: 0 0 20rpx 0;
}

.comment-item {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #eef0f3;
}

.comment-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d4fff4;
  color: #0d3d32;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 18rpx;
}

.comment-avatar image {
  width: 100%;
  height: 100%;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-author {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #151821;
}

.comment-text {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4a5568;
  line-height: 1.5;
  word-break: break-word;
}

.comment-time {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa3ad;
}

.comment-delete {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #d0d5dd;
  flex-shrink: 0;
  border-radius: 50%;
}

.comment-delete:active {
  background: #f2f3f5;
  color: #8a8a8a;
}

.comment-empty {
  padding: 40rpx 28rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa3ad;
}

.comment-input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef0f3;
}

.comment-input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  background: #f7f8fa;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #333;
}

.comment-submit {
  height: 64rpx;
  width: 80rpx;
  background: #13d8a8;
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  flex-shrink: 0;
}

.comment-submit[disabled] {
  opacity: 0.5;
}

.comment-login-hint {
  height: 64rpx;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}
