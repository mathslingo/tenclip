<page-meta page-style="{{pageStyle}}" background-color="{{slamBg}}" background-color-top="{{slamBg}}" background-color-bottom="{{slamBg}}" background-text-style="light" />
<view class="page" wx:if="{{note}}">
  <view class="page-main">
    <swiper
      wx:if="{{note.images && note.images.length}}"
      class="swiper"
      indicator-dots
      indicator-active-color="#13d8a8"
    >
      <swiper-item wx:for="{{note.images}}" wx:key="*this">
        <image class="slide" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreview" />
      </swiper-item>
    </swiper>

    <view class="author-row" wx:if="{{note.user_id}}">
      <view class="avatar" bindtap="onOpenAuthor">
        <image
          wx:if="{{note.author_avatar}}"
          class="avatar-img"
          src="{{note.author_avatar}}"
          mode="aspectFill"
        />
        <text wx:else class="avatar-letter">{{note.author_initial}}</text>
      </view>
      <view class="author-meta" bindtap="onOpenAuthor">
        <text class="author-name">{{note.author_name}}</text>
        <text class="time">{{timeText}}</text>
      </view>
      <view
        class="follow-btn {{following ? 'on' : ''}}"
        bindtap="onToggleFollow"
        wx:if="{{!isMine}}"
      >{{following ? '已关注' : '关注'}}</view>
    </view>

    <view class="body-card">
      <text class="title">{{note.title}}</text>
      <text class="body" selectable>{{note.body || note.summary}}</text>

      <view class="meta-row" wx:if="{{eventTimeText}}">
        <text class="meta-label">时间</text>
        <text class="meta-value">{{eventTimeText}}</text>
      </view>

      <view
        class="loc-row"
        wx:if="{{note.location_name || note.location_address}}"
        bindtap="onOpenLocation"
      >
        <view class="loc-pin"></view>
        <view class="loc-meta">
          <text class="loc-name">{{note.location_name || '地点'}}</text>
          <text class="loc-addr" wx:if="{{note.location_address}}">{{note.location_address}}</text>
        </view>
        <text class="loc-go" wx:if="{{canOpenMap}}">地图</text>
      </view>
    </view>

    <view class="action-bar">
      <view class="action-chip {{liked ? 'on' : ''}}" bindtap="onToggleLike" wx:if="{{!isMine}}">
        <text>{{liked ? '♥' : '♡'}} {{liked ? '已赞' : '赞'}}{{note.like_count ? ' ' + note.like_count : ''}}</text>
      </view>
      <view class="action-chip {{bookmarked ? 'on' : ''}}" bindtap="onToggleBookmark" wx:if="{{!isMine}}">
        <text>{{bookmarked ? '★' : '☆'}} {{bookmarked ? '已收藏' : '收藏'}}</text>
      </view>
      <button class="action-chip share-chip" open-type="share" hover-class="none">
        <text>↗ 分享</text>
      </button>
      <button class="danger-btn" bindtap="onDelete" wx:if="{{isMine}}">删除笔记</button>
    </view>
  </view>

  <view class="comment-dock">
    <view class="comment-section">
      <view class="comment-header">
        <text class="comment-count">评论 {{commentTotal}}</text>
      </view>

      <view class="comment-list" wx:if="{{comments.length}}">
        <view class="comment-thread" wx:for="{{comments}}" wx:key="id">
          <view class="comment-item">
            <view class="comment-avatar">
              <image
                wx:if="{{item.author_avatar}}"
                src="{{item.author_avatar}}"
                mode="aspectFill"
              />
              <text wx:else class="avatar-letter">{{item.author_initial}}</text>
            </view>
            <view class="comment-body">
              <text class="comment-author">{{item.author_name}}</text>
              <text class="comment-text">{{item.body}}</text>
              <view class="comment-meta">
                <text class="comment-time">{{item.time_text}}</text>
                <text
                  class="comment-reply-btn"
                  catchtap="onReplyComment"
                  data-id="{{item.id}}"
                  data-name="{{item.author_name}}"
                >回复</text>
              </view>
            </view>
            <view class="comment-delete" bindtap="onDeleteComment" data-id="{{item.id}}" wx:if="{{item.can_delete}}">×</view>
          </view>

          <view class="comment-replies" wx:if="{{item.replies && item.replies.length}}">
            <view class="comment-item comment-item--reply" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
              <view class="comment-avatar">
                <image
                  wx:if="{{reply.author_avatar}}"
                  src="{{reply.author_avatar}}"
                  mode="aspectFill"
                />
                <text wx:else class="avatar-letter">{{reply.author_initial}}</text>
              </view>
              <view class="comment-body">
                <text class="comment-author">{{reply.author_name}}</text>
                <text class="comment-text">
                  <text wx:if="{{reply.reply_to_name}}" class="reply-to">回复 {{reply.reply_to_name}}：</text>
                  <text>{{reply.body}}</text>
                </text>
                <view class="comment-meta">
                  <text class="comment-time">{{reply.time_text}}</text>
                  <text
                    class="comment-reply-btn"
                    catchtap="onReplyComment"
                    data-id="{{reply.id}}"
                    data-name="{{reply.author_name}}"
                  >回复</text>
                </view>
              </view>
              <view class="comment-delete" bindtap="onDeleteComment" data-id="{{reply.id}}" wx:if="{{reply.can_delete}}">×</view>
            </view>
          </view>
        </view>
      </view>

      <view class="comment-empty" wx:if="{{!comments.length && !loading}}">
        <text>还没有评论，来评个吧~</text>
      </view>
    </view>

    <view class="reply-hint" wx:if="{{replyTo}}" catchtap="onCancelReply">
      <text class="reply-hint-text">回复 @{{replyTo.name}}</text>
      <text class="reply-hint-cancel">取消</text>
    </view>

    <view class="comment-input-wrapper">
      <input
        class="comment-input"
        type="text"
        placeholder="{{commentPlaceholder}}"
        value="{{commentText}}"
        bindinput="onCommentInput"
        placeholder-style="color:#c0c5ce"
        wx:if="{{loggedIn}}"
      />
      <button
        class="comment-submit"
        bindtap="onSubmitComment"
        wx:if="{{loggedIn && commentText}}"
        loading="{{submitting}}"
        disabled="{{submitting || !commentText}}"
      >发</button>
      <view class="comment-login-hint" wx:if="{{!loggedIn}}" bindtap="onRequireLogin">
        登录后评论
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:else>
  <text>{{errorText || '加载中…'}}</text>
</view>
