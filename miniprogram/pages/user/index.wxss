page {
  background: #f2f3f5;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(160deg, #0f3d34 0%, #147a62 48%, #13d8a8 100%);
  color: #fff;
}

.hero-glow {
  position: absolute;
  right: -80rpx;
  top: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.hero-main {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  overflow: hidden;
  background: #baf5e8;
  flex-shrink: 0;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.18);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 52rpx;
  font-weight: 700;
  color: #0d3d32;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.uid {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.copy {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.ip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.stats-row {
  position: relative;
  margin-top: 28rpx;
  display: flex;
  gap: 8rpx;
}

.stat {
  min-width: 120rpx;
  padding-right: 24rpx;
}

.stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.bio {
  position: relative;
  display: block;
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.92);
  white-space: pre-wrap;
}

.bio.muted {
  color: rgba(255, 255, 255, 0.65);
}

.tag-list {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0d3d32;
  background: rgba(255, 255, 255, 0.88);
}

.action-row {
  position: relative;
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.btn.follow {
  background: #fff;
  color: #0d3d32;
}

.btn.follow.on {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.btn.edit {
  background: rgba(255, 255, 255, 0.92);
  color: #0d3d32;
}

.section-bar {
  margin: 8rpx 24rpx 0;
  padding: 24rpx 8rpx 12rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #151821;
}

.section-count {
  font-size: 24rpx;
  color: #9aa3ad;
}

.waterfall {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx 24rpx;
}

.col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.note-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.cover-wrap {
  position: relative;
  width: 100%;
  background: #e8ecf1;
}

.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f8f2;
}

.fallback-letter {
  font-size: 48rpx;
  color: #13d8a8;
  font-weight: 700;
}

.note-body {
  padding: 16rpx 16rpx 20rpx;
}

.note-title {
  font-size: 26rpx;
  color: #1a1f26;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty.full {
  padding-top: 240rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #5c6570;
  font-weight: 600;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa3ad;
}

.loading {
  padding: 240rpx 40rpx;
  text-align: center;
  color: #9aa3ad;
  font-size: 28rpx;
}
