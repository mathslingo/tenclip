<page-meta page-style="{{pageStyle}}" background-color="{{slamBg}}" background-color-top="{{slamBg}}" background-color-bottom="{{slamBg}}" background-text-style="light" />
<view class="detail-page" wx:if="{{item}}">
  <view class="detail-main">
    <view class="hero-cover">
      <image
        wx:if="{{!coverFailed}}"
        class="hero-img"
        src="{{item.cover}}"
        mode="widthFix"
        binderror="onCoverError"
      />
      <view wx:else class="hero-fallback">
        <text>{{item.author_initial}}</text>
      </view>
    </view>

    <view class="detail-card">
      <text class="detail-title">{{item.title}}</text>
      <view class="detail-author-row">
        <view class="avatar">{{item.author_initial}}</view>
        <view class="author-block">
          <text class="author-name">{{item.author_name}}</text>
          <text class="pub" wx:if="{{publishedText}}">{{publishedText}}</text>
        </view>
        <view class="likes">
          <text>♡ {{item.like_count}}</text>
        </view>
      </view>

      <text class="detail-summary">{{item.summary}}</text>

      <view class="tag-row" wx:if="{{item.tags && item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text>
      </view>

      <view class="action-row">
        <view class="action-chip {{liked ? 'on' : ''}}" bindtap="onToggleLike">
          <text>{{liked ? '♥' : '♡'}} {{liked ? '已赞' : '赞'}}{{item.like_count ? ' ' + item.like_count : ''}}</text>
        </view>
        <view class="action-chip {{bookmarked ? 'on' : ''}}" bindtap="onToggleBookmark">
          <text>{{bookmarked ? '★' : '☆'}} {{bookmarked ? '已收藏' : '收藏'}}</text>
        </view>
        <button class="action-chip share-chip" open-type="share" hover-class="none">
          <text>↗ 分享</text>
        </button>
      </view>
    </view>
  </view>

  <view class="comment-dock">
    <view class="comment-section">
      <view class="comment-header">
        <text class="comment-count">评论 {{commentTotal}}</text>
      </view>

      <view class="comment-list" wx:if="{{comments.length}}">
        <view class="comment-thread" wx:for="{{comments}}" wx:key="id">
          <view class="comment-item">
            <view class="comment-avatar">
              <image
                wx:if="{{item.author_avatar}}"
                src="{{item.author_avatar}}"
                mode="aspectFill"
              />
              <text wx:else class="avatar-letter">{{item.author_initial}}</text>
            </view>
            <view class="comment-body">
              <text class="comment-author">{{item.author_name}}</text>
              <text class="comment-text">{{item.body}}</text>
              <view class="comment-meta">
                <text class="comment-time">{{item.time_text}}</text>
                <text
                  class="comment-reply-btn"
                  catchtap="onReplyComment"
                  data-id="{{item.id}}"
                  data-name="{{item.author_name}}"
                >回复</text>
              </view>
            </view>
          </view>

          <view class="comment-replies" wx:if="{{item.replies && item.replies.length}}">
            <view class="comment-item comment-item--reply" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
              <view class="comment-avatar">
                <image
                  wx:if="{{reply.author_avatar}}"
                  src="{{reply.author_avatar}}"
                  mode="aspectFill"
                />
                <text wx:else class="avatar-letter">{{reply.author_initial}}</text>
              </view>
              <view class="comment-body">
                <text class="comment-author">{{reply.author_name}}</text>
                <text class="comment-text">
                  <text wx:if="{{reply.reply_to_name}}" class="reply-to">回复 {{reply.reply_to_name}}：</text>
                  <text>{{reply.body}}</text>
                </text>
                <view class="comment-meta">
                  <text class="comment-time">{{reply.time_text}}</text>
                  <text
                    class="comment-reply-btn"
                    catchtap="onReplyComment"
                    data-id="{{reply.id}}"
                    data-name="{{reply.author_name}}"
                  >回复</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="comment-empty" wx:if="{{!comments.length && !loading}}">
        <text>还没有评论</text>
      </view>
    </view>

    <view class="reply-hint" wx:if="{{replyTo}}" catchtap="onCancelReply">
      <text class="reply-hint-text">回复 @{{replyTo.name}}</text>
      <text class="reply-hint-cancel">取消</text>
    </view>

    <view class="comment-input-wrapper">
      <input
        class="comment-input"
        type="text"
        placeholder="{{commentPlaceholder}}"
        value="{{commentText}}"
        bindinput="onCommentInput"
        placeholder-style="color:#c0c5ce"
        wx:if="{{loggedIn}}"
      />
      <button
        class="comment-submit"
        bindtap="onSubmitComment"
        wx:if="{{loggedIn && commentText}}"
        loading="{{submitting}}"
        disabled="{{submitting || !commentText}}"
      >发</button>
      <view class="comment-login-hint" wx:if="{{!loggedIn}}" bindtap="onRequireLogin">
        登录后评论
      </view>
    </view>
  </view>
</view>

<view class="detail-loading" wx:else>
  <text>{{errorText || '加载中…'}}</text>
</view>
