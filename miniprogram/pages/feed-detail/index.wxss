.detail-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  min-height: 100vh;
}

.hero-cover {
  width: 100%;
  background: #e8eef2;
  min-height: 360rpx;
}

.hero-img {
  width: 100%;
  display: block;
  vertical-align: top;
}

.hero-fallback {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #baf5e8, #7ee0c8);
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(13, 61, 50, 0.4);
}

.detail-card {
  margin: -24rpx 24rpx 0;
  padding: 32rpx 28rpx 36rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #151821;
}

.detail-author-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #13d8a8;
  color: #0d3d32;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-block {
  flex: 1;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #151821;
}

.pub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa3af;
}

.likes {
  font-size: 26rpx;
  color: #6e7582;
}

.detail-summary {
  display: block;
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #415360;
  white-space: pre-wrap;
}

.tag-row {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #0d7a62;
  background: #eefbf6;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.primary-btn {
  margin-top: 36rpx;
  background: linear-gradient(140deg, #3bf0bf, #13d8a8);
  color: #0d3d32;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
}

.ghost-btn {
  margin-top: 16rpx;
  background: #fff;
  color: #0d3d32;
  border: 2rpx solid #13d8a8;
  border-radius: 20rpx;
  font-weight: 600;
}

.detail-loading {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9aa3af;
}
