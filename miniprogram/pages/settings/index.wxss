.settings-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: transparent;
  box-sizing: border-box;
}

.settings-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #f7fff9;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.16);
}

.slam-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slam-chip {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.slam-chip.on {
  border-color: #fff;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.35);
}

.slam-name {
  font-size: 28rpx;
  font-weight: 700;
}

.slam-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

.settings-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #151821;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.switch-text {
  flex: 1;
  min-width: 0;
}

.switch-label {
  display: block;
  font-size: 28rpx;
  color: #151821;
  font-weight: 600;
}

.switch-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa3af;
  line-height: 1.4;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.logout-btn,
.login-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.logout-btn {
  background: #fde8e8;
  color: #b42318;
}

.login-btn {
  background: linear-gradient(140deg, #3bf0bf, #13d8a8);
  color: #fff;
}

.build-tag {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #b0b7c0;
  word-break: break-all;
}
