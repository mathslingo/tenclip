@import "../../styles/common.wxss";

.profile-page {
  min-height: 100vh;
  padding: 24rpx 0 calc(220rpx + env(safe-area-inset-bottom));
  background: transparent;
  box-sizing: border-box;
}

.profile-card {
  margin: 0 24rpx;
  position: relative;
  z-index: 2;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(13, 61, 50, 0.08);
}

.profile-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  overflow: hidden;
  background: linear-gradient(145deg, #baf5e8, #13d8a8);
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 44rpx;
  font-weight: 700;
  color: #0d3d32;
}

.profile-info {
  width: 100%;
  min-width: 0;
  text-align: center;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #151821;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #0d6b52;
  background: #e8faf4;
}

.meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa3af;
}

.profile-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  min-width: 200rpx;
  text-align: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #415360;
  background: #f2f4f6;
}

.action-btn.primary {
  color: #042018;
  background: #3dffb0;
  font-weight: 600;
}

.stats-row {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef1f4;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #151821;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #9aa3af;
}

.bio {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #415360;
  text-align: center;
}

.tennis-line {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0d6b52;
  text-align: center;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #0d6b52;
  background: #eefaf6;
}

/* —— 快捷入口 —— */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 16rpx 24rpx 0;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.quick-icon {
  font-size: 48rpx;
  line-height: 1;
  color: #0d6b52;
}

.quick-text {
  font-size: 26rpx;
  color: #415360;
  font-weight: 500;
}

/* —— 内容标签 —— */
.content-tabs {
  display: flex;
  gap: 40rpx;
  margin: 12rpx 24rpx 0;
  padding: 0 8rpx;
}

.content-tab {
  position: relative;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.content-tab.active {
  color: var(--ink);
  font-weight: 600;
}

.content-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

.tab-count {
  font-size: 22rpx;
  color: #9aa3af;
}

/* —— 瀑布流 —— */
.waterfall {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 24rpx 0;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.cover-wrap {
  position: relative;
  width: 100%;
  background: #f0f2f5;
}

.cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f2f5;
}

.fallback-letter {
  font-size: 48rpx;
  color: #13d8a8;
  font-weight: 700;
}

.note-body {
  padding: 18rpx;
}

.note-title {
  font-size: 26rpx;
  color: #151821;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* —— 空状态 —— */
.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #151821;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa3af;
  text-align: center;
}

.empty-cta {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(140deg, #3bf0bf, #13d8a8);
}
