<view class="profile-page">
  <!-- 顶部绿色背景 -->
  <view class="profile-header">
    <view class="header-actions">
      <view class="header-btn" bindtap="onOpenSettings">设置</view>
      <view class="header-btn primary" bindtap="onEditProfile">编辑资料</view>
    </view>
  </view>

  <!-- 资料卡片 -->
  <view class="profile-card">
    <view class="profile-main">
      <view class="avatar" bindtap="onEditProfile">
        <image wx:if="{{profile.avatarUrl}}" class="avatar-img" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <text wx:else class="avatar-letter">{{avatarLetter}}</text>
      </view>
      <view class="profile-info">
        <view class="name-row">
          <text class="nickname">{{profile.nickname}}</text>
          <text class="gender" wx:if="{{profile.gender}}">{{profile.gender}}</text>
        </view>
        <text class="meta">小程序号 {{profile.uid}}<block wx:if="{{profile.location}}"> · IP {{profile.location}}</block></text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat" bindtap="onTapFollowing">
        <text class="stat-num">{{stats.following}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat" bindtap="onTapFollowers">
        <text class="stat-num">{{stats.followers}}</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.likedCollect}}</text>
        <text class="stat-label">获赞与收藏</text>
      </view>
    </view>

    <text class="bio" wx:if="{{profile.bio}}">{{profile.bio}}</text>
    <text class="tennis-line" wx:if="{{tennisLine}}">{{tennisLine}}</text>
    <view class="tag-list" wx:if="{{profile.tags.length}}">
      <text class="tag" wx:for="{{profile.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-grid">
    <view class="quick-item" bindtap="onGoStroke">
      <text class="quick-icon">✂</text>
      <text class="quick-text">击球剪辑</text>
    </view>
    <!-- 暂时下线：动作分析
    <view class="quick-item" bindtap="onGoAnalyze">
      <text class="quick-icon">◎</text>
      <text class="quick-text">动作分析</text>
    </view>
    -->
    <view class="quick-item" bindtap="onGoPose">
      <text class="quick-icon">◇</text>
      <text class="quick-text">实时关键点</text>
    </view>
    <view class="quick-item" bindtap="onGoFeed">
      <text class="quick-icon">▣</text>
      <text class="quick-text">发现资讯</text>
    </view>
  </view>

  <!-- 内容标签 -->
  <view class="content-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="content-tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >
      <text>{{item.label}}</text>
      <text class="tab-count" wx:if="{{item.count != null}}">{{item.count}}</text>
    </view>
  </view>

  <!-- 瀑布流内容 -->
  <view class="waterfall" wx:if="{{leftList.length || rightList.length}}">
    <view class="col">
      <view
        class="note-card"
        wx:for="{{leftList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <view class="cover-wrap" style="padding-bottom: {{item.cover_ratio * 100}}%;">
          <image
            wx:if="{{!item.coverFailed}}"
            class="cover"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
            data-id="{{item.id}}"
            data-col="left"
            binderror="onCoverError"
          />
          <view wx:else class="cover-fallback">
            <text class="fallback-letter">{{item.author_initial}}</text>
          </view>
        </view>
        <view class="note-body">
          <text class="note-title">{{item.title}}</text>
        </view>
      </view>
    </view>
    <view class="col">
      <view
        class="note-card"
        wx:for="{{rightList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <view class="cover-wrap" style="padding-bottom: {{item.cover_ratio * 100}}%;">
          <image
            wx:if="{{!item.coverFailed}}"
            class="cover"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
            data-id="{{item.id}}"
            data-col="right"
            binderror="onCoverError"
          />
          <view wx:else class="cover-fallback">
            <text class="fallback-letter">{{item.author_initial}}</text>
          </view>
        </view>
        <view class="note-body">
          <text class="note-title">{{item.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-block" wx:else>
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-sub">{{emptySub}}</text>
    <view class="empty-cta" bindtap="onEmptyCta" wx:if="{{emptyCta}}">{{emptyCta}}</view>
  </view>
</view>
