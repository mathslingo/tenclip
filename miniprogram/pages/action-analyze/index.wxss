@import "../../styles/common.wxss";

.pose-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.pose-entry-main {
  flex: 1;
  min-width: 0;
}

.pose-entry .card-title {
  font-size: 30rpx;
}

.pose-entry .card-sub {
  margin-top: 6rpx;
}

.pose-entry-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #13d8a8;
  line-height: 1;
}

.guidance-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.copy-link {
  font-size: 24rpx;
  color: #0d6b52;
  text-decoration: underline;
  flex-shrink: 0;
}

.guidance-panel {
  margin-top: 16rpx;
  max-height: 55vh;
  border: 2rpx solid #e5e9f0;
  border-radius: 24rpx;
  padding: 20rpx;
  background: #fbfcfe;
  box-sizing: border-box;
}

.guidance-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1a1f26;
  white-space: pre-wrap;
}

.meta-toggle {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #415360;
}

.guidance-meta {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f4f6f9;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #415360;
  white-space: pre-wrap;
}
