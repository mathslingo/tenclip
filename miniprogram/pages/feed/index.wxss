.feed-page {
  padding: 16rpx 12rpx calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* 顶部三 Tab */
.top-tabs {
  display: flex;
  gap: 8rpx;
  padding: 0 8rpx 16rpx;
}

.top-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6e7582;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e5e9f0;
}

.top-tab.active {
  color: #0d3d32;
  font-weight: 700;
  background: #d4fff4;
  border-color: #13d8a8;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 4rpx;
}

.col {
  flex: 1;
  min-width: 0;
}

.note-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.cover-wrap {
  position: relative;
  width: 100%;
  background: #e8eef2;
}

.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #baf5e8, #7ee0c8);
}

.fallback-letter {
  font-size: 64rpx;
  font-weight: 700;
  color: rgba(13, 61, 50, 0.45);
}

.play-badge {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.note-body {
  padding: 16rpx 14rpx 14rpx;
}

.note-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.4;
  color: #151821;
  font-weight: 600;
}

.note-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #13d8a8;
  color: #0d3d32;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-name {
  font-size: 22rpx;
  color: #6e7582;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.likes {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #6e7582;
  flex-shrink: 0;
}

.heart {
  font-size: 24rpx;
}

.feed-empty,
.feed-footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 24rpx;
  color: #9aa3af;
}
