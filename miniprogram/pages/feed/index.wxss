.feed-page {
  padding: 0 12rpx calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f5f5;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 12rpx 16rpx;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  color: #9aa3ad;
  font-size: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-placeholder {
  flex: 1;
}

.msg-bell {
  position: relative;
  padding: 4rpx 8rpx;
}

.bell-icon {
  font-size: 34rpx;
}

.bell-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  box-sizing: border-box;
}

