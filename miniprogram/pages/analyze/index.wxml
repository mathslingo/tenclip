<view class="page">
  <view class="page-inner">
    <view class="hero">
      <text class="hero-title">分析工具</text>
      <text class="hero-sub">剪辑 · 动作 · 实时关键点</text>
    </view>

    <view class="feature-grid">
      <view class="feature-card" bindtap="onGoStroke">
        <view class="feature-icon icon-stroke">✂</view>
        <view class="feature-info">
          <text class="feature-title">击球剪辑</text>
          <text class="feature-desc">自动剪掉换边与等待，保留击球回合</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>

      <view class="feature-card" bindtap="onGoAnalyze">
        <view class="feature-icon icon-analyze">◎</view>
        <view class="feature-info">
          <text class="feature-title">动作分析</text>
          <text class="feature-desc">AI 生成中文动作指导建议</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>

      <view class="feature-card feature-card-pose" bindtap="onGoPoseLive">
        <view class="feature-icon icon-pose">◇</view>
        <view class="feature-info">
          <text class="feature-title">实时关键点检测</text>
          <text class="feature-desc">端侧 YOLO Pose，手机浏览器实时骨架</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>

      <view class="feature-card" bindtap="onGoPoseClip">
        <view class="feature-icon icon-analyze">▣</view>
        <view class="feature-info">
          <text class="feature-title">姿态骨架回放</text>
          <text class="feature-desc">录 3–8 秒，云端出带回放的骨架视频</text>
        </view>
        <text class="feature-arrow">›</text>
      </view>
    </view>

    <view class="tips-card">
      <text class="tips-title">使用提示</text>
      <view class="tip-item">
        <view class="tip-bar"></view>
        <text class="tip-text">击球剪辑：上传完整训练视频，自动提取击球片段</text>
      </view>
      <view class="tip-item">
        <view class="tip-bar"></view>
        <text class="tip-text">动作分析：上传单个击球视频，获得技术建议</text>
      </view>
      <view class="tip-item">
        <view class="tip-bar"></view>
        <text class="tip-text">实时关键点：可小程序内嵌；开摄像头请用浏览器打开（效果更好）</text>
      </view>
      <view class="tip-item">
        <view class="tip-bar"></view>
        <text class="tip-text">骨架回放：真机录短视频，云端生成骨架回放</text>
      </view>
    </view>

    <view class="dev-info" wx:if="{{devMode}}">
      <text class="dev-title">开发者信息</text>
      <text class="dev-text">后端状态：{{backendStatus}}</text>
      <text class="dev-text">姿态服务：{{poseStatus}}</text>
      <view class="dev-action" bindtap="onTestBackend">
        <text>测试后端连接</text>
      </view>
    </view>
  </view>
</view>
