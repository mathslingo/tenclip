.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(ellipse 120% 60% at 50% -10%, rgba(19, 216, 168, 0.16), transparent 55%),
    linear-gradient(180deg, #f4fbf8 0%, #f7f8fa 42%, #f0f2f5 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.page-inner {
  width: 100%;
}

.hero {
  margin-bottom: 36rpx;
  padding: 0 8rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0d3d32;
  letter-spacing: 1rpx;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6e8580;
  line-height: 1.4;
}

.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border: 1rpx solid rgba(13, 61, 50, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(13, 61, 50, 0.05);
}

.feature-card:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.feature-card-pose {
  background: linear-gradient(135deg, rgba(19, 216, 168, 0.1) 0%, rgba(255, 255, 255, 0.95) 55%);
  border-color: rgba(19, 216, 168, 0.22);
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.icon-stroke {
  background: linear-gradient(145deg, #ffe8e0, #ffd4c8);
  color: #c45c3e;
}

.icon-analyze {
  background: linear-gradient(145deg, #e8fff6, #c8f5e6);
  color: #0d9b78;
}

.icon-pose {
  background: linear-gradient(145deg, #13d8a8, #0fb894);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(19, 216, 168, 0.35);
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #151821;
}

.feature-desc {
  font-size: 24rpx;
  color: #7a828e;
  line-height: 1.45;
}

.feature-arrow {
  font-size: 44rpx;
  color: #c5cad3;
  font-weight: 300;
  line-height: 1;
  padding-left: 4rpx;
}

.tips-card {
  margin-top: 28rpx;
  padding: 28rpx 28rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(13, 61, 50, 0.05);
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #3d4a46;
  margin-bottom: 18rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-bar {
  width: 6rpx;
  height: 28rpx;
  margin-top: 8rpx;
  border-radius: 6rpx;
  background: #13d8a8;
  flex-shrink: 0;
  opacity: 0.75;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #66706c;
  line-height: 1.55;
}

.dev-info {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #3d4f6f 0%, #2a3550 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #fff;
}

.dev-title {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.95;
}

.dev-text {
  font-size: 22rpx;
  display: block;
  margin-bottom: 10rpx;
  font-family: Menlo, Consolas, monospace;
  opacity: 0.82;
}

.dev-action {
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
}

.dev-action:active {
  opacity: 0.75;
}
