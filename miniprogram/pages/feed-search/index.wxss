@import "../../styles/common.wxss";

.search-page {
  padding: 0 12rpx calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f5f5;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 12rpx 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
  color: #9aa3ad;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #151821;
}

.search-btn {
  color: #13d8a8;
  font-size: 28rpx;
  font-weight: 600;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 4rpx;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.note-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.cover-wrap {
  position: relative;
  width: 100%;
  background: #f0f2f5;
}

.cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8ecf1;
}

.fallback-letter {
  font-size: 48rpx;
  font-weight: 700;
  color: #13d8a8;
}

.play-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tour-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(19, 216, 168, 0.9);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.note-body {
  padding: 16rpx;
}

.note-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #151821;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.author {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #d4fff4;
  color: #0d3d32;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar.avatar-img {
  padding: 0;
  display: block;
}

.author-name {
  font-size: 22rpx;
  color: #6e7582;
  max-width: 120rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.likes {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #9aa3ad;
}

.heart {
  color: #ff6b6b;
}

.empty, .loading {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8a8a8a;
  font-size: 28rpx;
}
