<view class="upload-overlay" wx:if="{{visible}}" catchtouchmove="preventMove">
  <view class="upload-overlay-panel">
    <text class="upload-overlay-title">{{title}}</text>
    <progress
      class="upload-overlay-bar"
      percent="{{percent}}"
      show-info
      stroke-width="10"
      activeColor="#13d8a8"
      backgroundColor="#e8ecf1"
      active
    />
    <text class="upload-overlay-msg">{{message}}</text>
    <text class="upload-overlay-hint">视频较大时压缩与上传各需数分钟，请保持在本页等待</text>
  </view>
</view>
