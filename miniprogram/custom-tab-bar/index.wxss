.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #0c3b2e;
  border-top: 1rpx solid rgba(157, 255, 224, 0.22);
  z-index: 9999;
}

.tab-bar-wrap {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 96rpx;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #b7e8d6;
}

.tab-item.active {
  color: #3dffb0;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.tab-action {
  position: relative;
  margin-top: -28rpx;
}

.action-ball {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  box-shadow:
    inset -10rpx -12rpx 0 rgba(0, 0, 0, 0.08),
    0 8rpx 22rpx rgba(0, 0, 0, 0.22);
}

.seam {
  position: absolute;
  width: 118%;
  height: 118%;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.seam-left {
  left: -58%;
  top: -9%;
  border-left-color: transparent;
  border-bottom-color: transparent;
  transform: rotate(28deg);
}

.seam-right {
  right: -58%;
  top: -9%;
  border-right-color: transparent;
  border-top-color: transparent;
  transform: rotate(28deg);
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}
