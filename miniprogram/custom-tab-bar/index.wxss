.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #0c3b2e;
  border-top: 1rpx solid rgba(157, 255, 224, 0.22);
  z-index: 9999;
}

.tab-bar-wrap {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 96rpx;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #b7e8d6;
}

.tab-item.active {
  color: #3dffb0;
}

/* Central action button styling */
.tab-action {
  position: relative;
  margin-top: -20rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

/* Special styling for the + action button */
.action-icon {
  width: 100rpx;
  height: 100rpx;
  background: #3dffb0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #042018;
  font-weight: 300;
  margin-bottom: 0;
  box-shadow: 0 6rpx 20rpx rgba(19, 216, 168, 0.3);
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}
